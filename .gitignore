# ==========================================
# HT (Harrio Translate) - .gitignore
# ==========================================

# 环境变量与密钥 (Environment & Secrets)
.env
.env.local
.env.*.local
*.pem
*.key

# 操作系统临时文件 (Operating System)
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# 日志文件 (Logs)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node.js / 前端开发产物 (Node.js & Frontend)
node_modules/
dist/
build/
out/
.next/
.nuxt/
.cache/
.turbo/

# Python / AI / 后端模型开发产物 (Python & AI/ML)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.pytest_cache/

# 模型权重与大型音频临时缓存 (Models & Media Temp)
models/*.bin
models/*.onnx
models/*.pt
models/*.safetensors
*.wav
*.mp3
*.flac
*.pcm

# IDE & 编辑器配置 (Editor Directories)
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
