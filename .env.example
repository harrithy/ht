# ==========================================
# HT (Harrio Translate) - Environment Configuration
# ==========================================

# 默认源语言与目标语言
HT_DEFAULT_SOURCE_LANG=auto
HT_DEFAULT_TARGET_LANG=zh-CN

# 翻译服务提供商 (openai / deepseek / azure / local)
HT_TRANSLATION_PROVIDER=deepseek

# API 配置 (根据所选 Provider 填入)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 音频与流式识别 (ASR / STT)
ASR_PROVIDER=browser_native # browser_native / whisper_local / whisper_api
WHISPER_API_KEY=

# 实时同传悬浮窗配置
OVERLAY_ALWAYS_ON_TOP=true
OVERLAY_OPACITY=0.92
